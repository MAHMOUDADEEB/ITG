@using Microsoft.AspNetCore.Identity
@inject UserManager<Employee> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);

    // Initials for the avatar ("Omar Haddad" -> "OH")
    var initials = string.Concat((currentUser?.Name ?? "?")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));

    var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var targetCulture = isArabic ? AppCultures.English : AppCultures.Arabic;
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="topbar-actions">

    @* ---------- Notifications ---------- *@
    <partial name="_NotificationBell" />

    @* ---------- User menu ---------- *@
    <div class="dropdown">
        <button type="button" class="topbar-icon-btn topbar-user-btn" data-bs-toggle="dropdown" aria-expanded="false"
                aria-label="@L["Account"]" title="@currentUser?.Name">
            <span class="topbar-avatar" aria-hidden="true">@initials</span>
        </button>
        <div class="dropdown-menu dropdown-menu-end topbar-dropdown">
            <div class="topbar-user-head">
                <span class="topbar-avatar" aria-hidden="true">@initials</span>
                <div class="min-w-0">
                    <div class="topbar-user-name">@currentUser?.Name</div>
                    <div class="topbar-user-mail" dir="ltr">@currentUser?.Email</div>
                </div>
            </div>
            <hr class="dropdown-divider" />
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                <button type="submit" class="dropdown-item">
                    <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>@L["Logout"]
                </button>
            </form>
        </div>
    </div>

    @* ---------- Language ---------- *@
    <form asp-area="" asp-controller="Language" asp-action="Set" method="post" class="m-0">
        <input type="hidden" name="culture" value="@targetCulture" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <button type="submit" class="topbar-icon-btn"
                aria-label="@L["Switch language"]" title="@(isArabic ? "English" : "العربية")">
            <i class="bi bi-translate" aria-hidden="true"></i>
        </button>
    </form>

    @* ---------- Theme ---------- *@
    <button type="button" class="topbar-icon-btn" data-theme-toggle
            aria-label="@L["Switch theme"]" title="@L["Switch theme"]">
        <i class="bi bi-moon icon-moon" aria-hidden="true"></i>
        <i class="bi bi-sun icon-sun" aria-hidden="true"></i>
    </button>

</div>