@* Global search box in the top bar *@
<form class="topbar-search" asp-area="" asp-controller="Search" asp-action="Index" method="get" role="search">
    <i class="bi bi-search" aria-hidden="true"></i>
    <input type="search" name="q" value="@Context.Request.Query["q"]"
           placeholder="@L["Search for courses or skills..."]" aria-label="@L["Search"]" autocomplete="off"
           data-search-input />
    <kbd class="search-kbd" title="@L["Press / to search"]">/</kbd>
</form>
