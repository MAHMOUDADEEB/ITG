@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var items = User.IsInRole(AppRoles.Admin)
        ? NavigationMenu.AdminItems
        : NavigationMenu.EmployeeItems;
}

<nav class="sidebar-nav" aria-label="@L["Main menu"]">
    <p class="sidebar-section">@L["Menu"]</p>
    <ul class="sidebar-menu">
        @foreach (var item in items)
        {
            var isActive = string.Equals(currentArea, item.Area, StringComparison.OrdinalIgnoreCase)
                        && string.Equals(currentController, item.Controller, StringComparison.OrdinalIgnoreCase);

            <li>
                <a class="sidebar-link @(isActive ? "active" : "")"
                   asp-area="@item.Area" asp-controller="@item.Controller" asp-action="Index"
                   aria-current="@(isActive ? "page" : null)" title="@L[item.Text]">
                    <i class="bi @item.Icon" aria-hidden="true"></i>
                    <span>@L[item.Text]</span>
                </a>
            </li>
        }
    </ul>

    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="sidebar-logout">
        <button type="submit" class="sidebar-link" title="@L["Logout"]">
            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
            <span>@L["Logout"]</span>
        </button>
    </form>
</nav>