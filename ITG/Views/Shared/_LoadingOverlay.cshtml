@* Full-screen "please wait" shown while the AI prepares questions (see site.js: data-loading) *@
<div class="loading-overlay" data-loading-overlay hidden role="status" aria-live="polite">
    <div class="loading-box">
        <span class="loading-spinner" aria-hidden="true"></span>
        <p class="loading-text" data-loading-text></p>
        <p class="loading-hint">@L["This can take a few seconds."]</p>
        <div class="loading-bar" aria-hidden="true"><span></span></div>
    </div>
</div>
