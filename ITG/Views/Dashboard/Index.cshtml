@model DashboardViewModel
@{
    ViewData["Title"] = L["Dashboard"].Value;
    var progress = Model.Progress;
    var next = progress.NextStep;
}

<header class="page-header">
    <h2 class="page-title">@L["Learning Overview"]</h2>
</header>

@* ---------- Career progress ---------- *@
<section class="surface surface--tinted progress-card" aria-labelledby="progressTitle">
    <h3 class="progress-card-title" id="progressTitle">@L["Career Progress"]</h3>

    @if (progress.HasTarget)
    {
        <div class="career-progress">
            <partial name="_ProgressRing" model="progress.Percent" />
            <div class="career-progress-body">
                <partial name="_RoleTransition" model="progress" />
                <p class="career-progress-text">
                    @L["{0} of {1} requirements completed", progress.CompletedCount, progress.TotalCount]
                </p>
            </div>
        </div>

        if (progress.IsReadyForPromotion)
        {
            <p class="progress-card-note progress-card-note--success">
                <i class="bi bi-patch-check-fill" aria-hidden="true"></i>
                @L["All certificates are verified. You are ready for promotion."]
            </p>
        }
    }
    else
    {
        <partial name="_RoleTransition" model="progress" />
    }
</section>

<div class="row g-4 mt-1">

    @* ---------- Last exam ---------- *@
    <div class="col-md-6">
        <section class="surface surface--solid info-card h-100" aria-labelledby="lastExamTitle">
            <h3 class="info-card-title" id="lastExamTitle">@L["Last Exam"]</h3>

            @if (Model.LastExam != null)
            {
                <p class="info-card-item">@Model.LastExam.ExamTitle</p>
                <div class="exam-result">
                    <span class="exam-result-meta">
                        @L["Attempt {0}", Model.LastExam.AttemptNumber] · @(Model.LastExam.Score >= AppConstants.ExamPassingScore ? L["Passed"] : L["Failed"])
                    </span>
                    <span class="exam-result-score">
                        <strong>@Model.LastExam.Score/100</strong>
                        <small>@L["Score"]</small>
                    </span>
                </div>
            }
            else
            {
                <div class="empty-inline">
                    <p>@L["You have not taken any exams yet."]</p>
                    <a class="link-arrow" asp-controller="Exams" asp-action="Index">
                        @L["Browse Exams"] <i class="bi bi-chevron-right flip-rtl" aria-hidden="true"></i>
                    </a>
                </div>
            }
        </section>
    </div>

    @* ---------- Next step ---------- *@
    <div class="col-md-6">
        <section class="surface surface--solid info-card h-100" aria-labelledby="nextStepTitle">
            <h3 class="info-card-title" id="nextStepTitle">
                <a asp-controller="Roadmap" asp-action="Index" class="info-card-title-link">
                    @L["Next Step"] <i class="bi bi-chevron-right flip-rtl" aria-hidden="true"></i>
                </a>
            </h3>

            @if (next != null)
            {
                <p class="info-card-item">@next.Title</p>
                <p class="info-card-text">@next.Description</p>
                <div class="info-card-action">
                    <a class="btn btn-itg" asp-controller="Roadmap" asp-action="Index" asp-fragment="cert-@next.CertificateId">
                        @L["View in Roadmap"]
                    </a>
                </div>
            }
            else if (progress.IsReadyForPromotion)
            {
                <div class="empty-inline">
                    <p>@L["All certificates are completed. Great work!"]</p>
                </div>
            }
            else if (progress.CanChoosePath)
            {
                <div class="empty-inline">
                    <p>@L["Choose your path first to see your next step."]</p>
                </div>
            }
            else if (progress.IsAwaitingPathDecision)
            {
                <div class="empty-inline">
                    <p>@L["HR will set your next career path soon."]</p>
                </div>
            }
            else
            {
                <div class="empty-inline">
                    <p>@L["No certificates are required right now."]</p>
                </div>
            }
        </section>
    </div>

</div>
