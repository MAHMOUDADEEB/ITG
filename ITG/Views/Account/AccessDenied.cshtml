@{
    ViewData["Title"] = L["Access Denied"].Value;
}

<div class="text-center py-5">
    <i class="bi bi-shield-lock text-danger" style="font-size: 3.5rem;" aria-hidden="true"></i>
    <h1 class="h3 mt-3">@L["Access Denied"]</h1>
    <p class="text-body-secondary">@L["You don't have permission to view this page."]</p>
    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-auth w-auto px-4">@L["Back to Home"]</a>
</div>